<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\MtgMcp.Core\MtgMcp.Core.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mtg-mcp</ToolCommandName>
        <PackageId>Nccurry.MtgMcp</PackageId>
        <Version>0.9.0-preview.1</Version>
        <PackageVersion>0.9.0-preview.1</PackageVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Authors>Nick Curry</Authors>
        <Company>Nick Curry</Company>
        <Description>The evidence-first foundation preview of a C#/.NET MCP server for Magic: The Gathering.</Description>
        <PackageTags>mcp;model-context-protocol;magic-the-gathering;mtg</PackageTags>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/nccurry/mtg-mcp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nccurry/mtg-mcp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
