<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\MtgMcp.Core\MtgMcp.Core.csproj" />
        <ProjectReference Include="..\MtgMcp.Scryfall\MtgMcp.Scryfall.csproj" />
        <ProjectReference Include="..\MtgMcp.Archidekt\MtgMcp.Archidekt.csproj" />
        <ProjectReference Include="..\MtgMcp.CommanderSpellbook\MtgMcp.CommanderSpellbook.csproj" />
        <ProjectReference Include="..\MtgMcp.Decklists\MtgMcp.Decklists.csproj" />
        <ProjectReference Include="..\MtgMcp.Moxfield\MtgMcp.Moxfield.csproj" />
        <ProjectReference Include="..\MtgMcp.Playgroup\MtgMcp.Playgroup.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="ModelContextProtocol" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mtg-mcp</ToolCommandName>
        <PackageId>Nccurry.MtgMcp</PackageId>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Authors>Nick Curry</Authors>
        <Company>Nick Curry</Company>
        <Description>A C#/.NET MCP server for building Magic: The Gathering decks with Scryfall card data, Moxfield imports, and Archidekt deck writeback.</Description>
        <PackageTags>mcp;model-context-protocol;magic-the-gathering;mtg;scryfall;archidekt;moxfield</PackageTags>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/nccurry/mtg-mcp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nccurry/mtg-mcp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
