<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\MtgMcp.Core\MtgMcp.Core.csproj" />
        <ProjectReference Include="..\MtgMcp.Decks\MtgMcp.Decks.csproj" />
        <ProjectReference Include="..\MtgMcp.Scryfall\MtgMcp.Scryfall.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="ModelContextProtocol" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>mtg-mcp</ToolCommandName>
        <PackageId>Nccurry.MtgMcp</PackageId>
        <Version>0.9.0-preview.1</Version>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Authors>Nick Curry</Authors>
        <Company>Nick Curry</Company>
        <Description>An evidence-first C#/.NET MCP server with revisioned local Magic: The Gathering deck workflows.</Description>
        <PackageTags>mcp;model-context-protocol;magic-the-gathering;mtg</PackageTags>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/nccurry/mtg-mcp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/nccurry/mtg-mcp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
