<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\MtgMcp.Scryfall.Tests\RecordedCards.cs" Link="Fixtures\RecordedCards.cs" />
        <Compile Include="..\MtgMcp.Scryfall.Tests\ScryfallTestFixture.cs" Link="Fixtures\ScryfallTestFixture.cs" />
        <Compile Include="..\MtgMcp.Archidekt.Tests\ArchidektTestHttpHandler.cs" Link="Fixtures\ArchidektTestHttpHandler.cs" />
        <Compile Include="..\MtgMcp.Core.Tests\Recorded\RecordedManifest.cs" Link="Recorded\RecordedManifest.cs" />
        <Compile Include="..\MtgMcp.Core.Tests\Recorded\JsonShape.cs" Link="Recorded\JsonShape.cs" />
        <None Include="..\MtgMcp.Archidekt.Tests\Fixtures\recorded\**\*.json" Link="Fixtures\recorded\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\MtgMcp.Scryfall.Tests\Fixtures\recorded\cards-id\*.json" Link="Fixtures\recorded\cards-id\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Fixtures\commander-rules\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Fixtures/on-curve-replay.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Fixtures/simulate-golden.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\MtgMcp.Spellbook.Tests\Fixtures\*.json" Link="Fixtures\spellbook\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MtgMcp.App\MtgMcp.App.csproj" />
    </ItemGroup>
</Project>
